# Production config
NODE_ENV=production
PORT=3000

# Set a long random password for the initial admin account (min. 12 chars)
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-something-secure

# Set to true if you want anyone to be able to sign up
ALLOW_SELF_REGISTRATION=false

# Where staff-reply notifications get sent
SUPPORT_EMAIL=support@yourdomain.com

# Outgoing mail (optional — leave blank to disable email notifications)
MAIL_FROM=support@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# OAuth login (optional — leave blank to disable the OAuth buttons)
APP_URL=http://localhost:5173
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
